<UserControl x:Class="Left4DeadTrollControl.AppClient.Pages.ImportExportPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Left4DeadTrollControl.AppClient.Pages"
      xmlns:fa="http://schemas.awesome.incremented/wpf/xaml/fontawesome.sharp"
      mc:Ignorable="d" 
      d:DesignHeight="550" d:DesignWidth="560">

    <UserControl.Resources>
        <!-- Primary Button Style -->
        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#007ACC"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="30,12"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                BorderThickness="0"
                                CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Margin="{TemplateBinding Padding}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#005A9E"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#CCCCCC"/>
                    <Setter Property="Foreground" Value="#666666"/>
                    <Setter Property="Cursor" Value="Arrow"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- ProgressBar Style -->
        <Style TargetType="ProgressBar">
            <Setter Property="Height" Value="25"/>
            <Setter Property="Background" Value="#E0E0E0"/>
            <Setter Property="Foreground" Value="#007ACC"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="12"
                                BorderThickness="0">
                            <Grid>
                                <Border x:Name="PART_Track" />
                                <Border x:Name="PART_Indicator" 
                                        HorizontalAlignment="Left"
                                        Background="{TemplateBinding Foreground}"
                                        CornerRadius="12"/>
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Background="White">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#007ACC" Padding="20,15">
            <TextBlock Text="Import / Export" 
                       Foreground="White" 
                       FontSize="24" 
                       FontWeight="SemiBold"/>
        </Border>

        <!-- Content -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="30,20,30,30">

                <!-- Info -->
                <Border Background="#F9F9F9" 
                        BorderBrush="#E0E0E0" 
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="20"
                        Margin="0,0,0,30">
                    <StackPanel>
                        <TextBlock Text="Information" 
                                   FontSize="16" 
                                   FontWeight="SemiBold"
                                   Foreground="#333333"
                                   Margin="0,0,0,15"/>
                        
                        <TextBlock TextWrapping="Wrap" 
                                   FontSize="13" 
                                   Foreground="#666666"
                                   LineHeight="20">
                            <Run Text="The Import button allows you to import Troll log data using a properly formatted 'CSV' file. The Export button allows you to generate the CSV file for later export."/>
                        </TextBlock>
                    </StackPanel>
                </Border>

                <!-- Progress Area -->
                <Border Background="White"
                        BorderBrush="#E0E0E0"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="30,10,30,10"
                        Margin="0,0,0,30">
                    <StackPanel>
                        <!-- Status -->
                        <TextBlock x:Name="StatusTextBlock" 
                                   Text="{Binding StatusText}" 
                                   FontSize="14" 
                                   FontWeight="Medium"
                                   Foreground="#666666"
                                   HorizontalAlignment="Center"
                                   Margin="0,0,0,20"/>

                        <!-- Progress Bar -->
                        <ProgressBar x:Name="ProgressBar" 
                                     Value="{Binding ProgressValue}" 
                                     Minimum="0" 
                                     Maximum="100"
                                     Margin="0,0,0,10"/>

                        <!-- Percentage -->
                        <TextBlock x:Name="PercentageTextBlock"
                                   Text="{Binding PercentageText}"
                                   FontSize="13"
                                   Foreground="#999999"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- Action Buttons -->
                <Grid HorizontalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Import Button -->
                    <Button Grid.Column="0" 
                            x:Name="ImportButton" 
                            Content="Import" 
                            Style="{StaticResource PrimaryButtonStyle}"
                            Command="{Binding ImportCommand}"
                            IsEnabled="{Binding IsGenerating, Converter={StaticResource InverseBooleanConverter}}"
                            Margin="0,0,10,0"/>

                    <!-- Export Button -->
                    <Button Grid.Column="1" 
                            x:Name="ExportButton" 
                            Content="Export" 
                            Style="{StaticResource PrimaryButtonStyle}"                            
                            Command="{Binding ExportCommand}"
                            IsEnabled="{Binding IsGenerating, Converter={StaticResource InverseBooleanConverter}}"
                            Margin="10,0,0,0"/>
                </Grid>

                <!-- Additional Info -->
                <TextBlock Text="Make sure you have registered at least one troll before exporting data."
                           FontSize="11"
                           Foreground="#999999"
                           HorizontalAlignment="Center"
                           Margin="0,15,0,0"
                           TextWrapping="Wrap"
                           TextAlignment="Center"/>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
